[Unit]
Description=DirMover - 定时目录迁移 Web 服务
After=network.target

[Service]
Type=simple
# 按实际情况修改用户、路径
User=dirmover
Group=dirmover
WorkingDirectory=/opt/dirmover
Environment=DIRMOVER_DATA=/var/lib/dirmover
Environment=DIRMOVER_LOG_DIR=/var/log/dirmover
Environment=DIRMOVER_HOST=0.0.0.0
Environment=DIRMOVER_PORT=8000
ExecStart=/opt/dirmover/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
